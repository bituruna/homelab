#!/usr/bin/bash

# Bloqueia commits que contenham material de chave privada.
# Verifica as alterações preparadas para o próximo commit.
if git diff --cached -U0 | grep -qE 'BEGIN (OPENSSH |RSA |EC |DSA )?PRIVATE KEY'; then
  echo "ERRO: possível chave privada no commit. Commit abortado." >&2
  exit 1
fi
